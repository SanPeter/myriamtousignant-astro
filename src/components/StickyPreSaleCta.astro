---
import { PRE_SALE_CONFIG } from '../config/preSale';

const defaultCopy = PRE_SALE_CONFIG.copy;
const editions = PRE_SALE_CONFIG.editions;
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4"
  data-testid="pre-sale-sticky"
  data-pre-sale-sticky
  hidden
>
  <aside class="pointer-events-auto relative w-full max-w-3xl rounded-lg bg-gray-900 px-4 py-3 pr-16 md:pr-20 text-white shadow-lg">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div class="min-w-0">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gray-300">
          {defaultCopy.stickyTitle}
        </p>
        <p class="text-sm md:text-base">
          {defaultCopy.stickyMessage}
        </p>
      </div>
      <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap md:mr-6">
        {editions.map((edition) => (
          <a
            href={edition.squareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex shrink-0 items-center justify-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-100"
            aria-label={edition.ariaLabel}
            data-testid={`pre-sale-sticky-cta-${edition.id}`}
            data-pre-sale-order-link
            data-pre-sale-edition={edition.name}
            data-pre-sale-toast-message={edition.toastMessage}
          >
            {edition.stickyCtaLabel}
          </a>
        ))}
      </div>
    </div>
    <button
      type="button"
      class="absolute right-4 top-4 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-gray-500 text-lg leading-none text-gray-200 transition-colors hover:bg-gray-800 md:right-5"
      data-pre-sale-sticky-close
      aria-label={defaultCopy.stickyCloseLabel}
    >
      ×
    </button>
  </aside>
</div>

<script is:inline define:vars={{ windowConfig: PRE_SALE_CONFIG.window }}>
  (() => {
    const sticky = document.querySelector('[data-pre-sale-sticky]');
    if (!sticky) {
      return;
    }

    const parseDate = (dateValue) => {
      if (!dateValue) {
        return null;
      }

      const parsed = new Date(dateValue);
      return Number.isNaN(parsed.getTime()) ? null : parsed;
    };

    const start = parseDate(windowConfig.startsAt);
    const end = parseDate(windowConfig.endsAt);
    const now = new Date();
    const isVisible = (!start || now >= start) && (!end || now <= end);
    if (!isVisible) {
      sticky.hidden = true;
      return;
    }

    const banner = document.querySelector('[data-pre-sale-banner]');
    if (!banner || banner.hidden) {
      sticky.hidden = true;
      return;
    }

    const storageKey = 'pre-sale-sticky-dismissed';
    let dismissed = sessionStorage.getItem(storageKey) === '1';
    if (dismissed) {
      sticky.hidden = true;
      return;
    }

    const closeButton = sticky.querySelector('[data-pre-sale-sticky-close]');
    if (closeButton) {
      closeButton.addEventListener('click', () => {
        dismissed = true;
        sessionStorage.setItem(storageKey, '1');
        sticky.hidden = true;
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (dismissed) {
          sticky.hidden = true;
          return;
        }

        const firstEntry = entries[0];
        const inView = Boolean(firstEntry?.isIntersecting);
        sticky.hidden = inView;
      },
      {
        threshold: 0.15
      }
    );

    observer.observe(banner);
  })();
</script>
