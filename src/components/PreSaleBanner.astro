---
import { PRE_SALE_CONFIG, isPreSaleVisible } from '../config/preSale';

const defaultContent = PRE_SALE_CONFIG.copy.fr;
const isVisible = isPreSaleVisible(PRE_SALE_CONFIG.window);
---

{isVisible && (
  <section
    class="w-full border-y border-zinc-200 bg-zinc-50 px-4 py-8 text-zinc-800 md:px-8 md:py-10"
    aria-labelledby="pre-sale-title"
    data-testid="pre-sale-banner"
    data-pre-sale-banner
  >
    <div class="w-full">
      <header class="space-y-2">
        <h2 id="pre-sale-title" class="text-5xl leading-none tracking-tight text-zinc-900 md:text-6xl" data-pre-sale-field="title">
          {defaultContent.title}
        </h2>
        <p class="text-2xl text-zinc-700" data-pre-sale-field="subtitle">{defaultContent.subtitle}</p>
        <p class="text-xl text-zinc-700" data-pre-sale-field="artistLine">{defaultContent.artistLine}</p>
        <p class="text-xl text-zinc-700" data-pre-sale-field="availabilityLine">{defaultContent.availabilityLine}</p>
      </header>

      <div class="mt-6 flex flex-wrap items-center gap-5">
        <a
          href={PRE_SALE_CONFIG.squareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full bg-zinc-900 px-7 py-2 text-lg font-medium text-zinc-50 transition-colors hover:bg-zinc-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-900"
          data-pre-sale-field="heroCta"
          aria-label={defaultContent.heroCtaAriaLabel}
          data-testid="pre-sale-cta"
        >
          {defaultContent.heroCtaLabel}
        </a>

        <a
          href="#pre-sale-editorial"
          class="inline-flex items-center gap-2 text-lg text-zinc-700 underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-700"
          data-pre-sale-field="detailsLink"
          data-testid="pre-sale-details-link"
        >
          <span aria-hidden="true">›</span>
          <span>{defaultContent.detailsLinkLabel}</span>
        </a>
      </div>

      <div id="pre-sale-editorial" class="mt-10 space-y-4 text-left text-2xl leading-relaxed text-zinc-700" data-pre-sale-field="editorial">
        {defaultContent.editorialParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="mt-8 grid grid-cols-1 gap-3 border border-zinc-200 bg-zinc-50 p-4 md:grid-cols-[2fr_1fr]" data-pre-sale-field="cardsWrapper">
        <article class="border border-zinc-200 bg-zinc-50 p-4" data-pre-sale-field="limitedCard">
          <h3 class="text-4xl leading-snug text-zinc-900" data-pre-sale-field="limitedCardTitle">
            {defaultContent.limitedEditionCard.title}
          </h3>
          <ul class="mt-3 space-y-2 text-lg text-zinc-700" data-pre-sale-field="limitedCardLines">
            {defaultContent.limitedEditionCard.lines.map((line) => (
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="border border-zinc-200 bg-zinc-50 p-4" data-pre-sale-field="luxeCard">
          <h3 class="text-4xl leading-snug text-zinc-900" data-pre-sale-field="luxeCardTitle">
            {defaultContent.luxeEditionCard.title}
          </h3>
          <ul class="mt-3 space-y-2 text-lg text-zinc-700" data-pre-sale-field="luxeCardLines">
            {defaultContent.luxeEditionCard.lines.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </article>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2" data-pre-sale-field="bottomCtas">
        <a
          href={PRE_SALE_CONFIG.squareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-14 items-center justify-center rounded-md border border-zinc-300 bg-zinc-50 px-4 py-3 text-2xl text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800"
          data-pre-sale-field="bottomPrimaryCta"
          aria-label={defaultContent.bottomCtas.primaryAriaLabel}
          data-testid="pre-sale-bottom-cta-primary"
        >
          {defaultContent.bottomCtas.primaryLabel}
        </a>
        <a
          href={PRE_SALE_CONFIG.squareUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-14 items-center justify-center rounded-md border border-zinc-300 bg-zinc-50 px-4 py-3 text-2xl text-zinc-800 transition-colors hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-800"
          data-pre-sale-field="bottomSecondaryCta"
          aria-label={defaultContent.bottomCtas.secondaryAriaLabel}
          data-testid="pre-sale-bottom-cta-secondary"
        >
          {defaultContent.bottomCtas.secondaryLabel}
        </a>
      </div>
    </div>
  </section>
)}

<script
  is:inline
  define:vars={{ translations: PRE_SALE_CONFIG.copy }}
>
  (() => {
    const banner = document.querySelector('[data-pre-sale-banner]');
    if (!banner) {
      return;
    }

    const getLocaleFromQuery = () => {
      const langParam = new URLSearchParams(window.location.search).get('lang');
      if (langParam === 'en' || langParam === 'fr') {
        return langParam;
      }
      return null;
    };

    const inferLocale = () => {
      const queryLocale = getLocaleFromQuery();
      if (queryLocale) {
        return queryLocale;
      }

      const htmlLang = document.documentElement.lang || '';
      if (htmlLang.startsWith('en')) {
        return 'en';
      }

      return (navigator.language || '').toLowerCase().startsWith('en') ? 'en' : 'fr';
    };

    const locale = inferLocale();
    const content = translations[locale] || translations.fr;

    const setText = (field, value) => {
      const node = banner.querySelector(`[data-pre-sale-field="${field}"]`);
      if (node) {
        node.textContent = value;
      }
    };

    setText('title', content.title);
    setText('subtitle', content.subtitle);
    setText('artistLine', content.artistLine);
    setText('availabilityLine', content.availabilityLine);
    setText('heroCta', content.heroCtaLabel);
    setText('detailsLink', content.detailsLinkLabel);
    setText('limitedCardTitle', content.limitedEditionCard.title);
    setText('luxeCardTitle', content.luxeEditionCard.title);
    setText('bottomPrimaryCta', content.bottomCtas.primaryLabel);
    setText('bottomSecondaryCta', content.bottomCtas.secondaryLabel);

    const editorial = banner.querySelector('[data-pre-sale-field="editorial"]');
    if (editorial) {
      editorial.innerHTML = '';
      for (const paragraph of content.editorialParagraphs) {
        const node = document.createElement('p');
        node.textContent = paragraph;
        editorial.appendChild(node);
      }
    }

    const replaceLines = (selector, lines, withChecks = false) => {
      const list = banner.querySelector(selector);
      if (!list) {
        return;
      }

      list.innerHTML = '';
      for (const line of lines) {
        const item = document.createElement('li');
        if (withChecks) {
          item.className = 'flex items-start gap-2';
          const icon = document.createElement('span');
          icon.setAttribute('aria-hidden', 'true');
          icon.textContent = '✓';
          const text = document.createElement('span');
          text.textContent = line;
          item.append(icon, text);
        } else {
          item.textContent = line;
        }
        list.appendChild(item);
      }
    };

    replaceLines('[data-pre-sale-field="limitedCardLines"]', content.limitedEditionCard.lines, true);
    replaceLines('[data-pre-sale-field="luxeCardLines"]', content.luxeEditionCard.lines);

    const heroCta = banner.querySelector('[data-pre-sale-field="heroCta"]');
    if (heroCta) {
      heroCta.setAttribute('aria-label', content.heroCtaAriaLabel);
    }

    const bottomPrimary = banner.querySelector('[data-pre-sale-field="bottomPrimaryCta"]');
    if (bottomPrimary) {
      bottomPrimary.setAttribute('aria-label', content.bottomCtas.primaryAriaLabel);
    }

    const bottomSecondary = banner.querySelector('[data-pre-sale-field="bottomSecondaryCta"]');
    if (bottomSecondary) {
      bottomSecondary.setAttribute('aria-label', content.bottomCtas.secondaryAriaLabel);
    }

    document.documentElement.lang = locale;
  })();
</script>
